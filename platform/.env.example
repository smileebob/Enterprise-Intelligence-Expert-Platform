# Enterprise Domain-Expert Agent Platform - env template (copy to .env)
# All demo data is simulated for the competition (is_mock); marked in UI and docs.
# Keep this file ASCII-only (slowapi/starlette reads it with the system locale codec on Windows).

# ---- base ----
APP_ENV=development            # development / testing / production
APP_NAME=angentplatform
APP_CODE=angentplatform
DEBUG=true
SECRET_KEY=dev-only-secret-change-me-please-32bytes
LOG_LEVEL=INFO
LOG_FORMAT=text                # text (dev) / json (prod)

# ---- storage (dev: SQLite; prod/compose: PostgreSQL16+pgvector) ----
DATABASE_URL=sqlite:///./var/app.db
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/angentplatform

# ---- cache/lock (dev: memory; prod: Valkey/Redis) ----
CACHE_BACKEND=memory           # memory / redis
REDIS_URL=redis://valkey:6379/0

# ---- async tasks (dev: eager; prod: Celery+Valkey) ----
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://valkey:6379/1

# ---- model gateway (used when DEMO_MODE=live; any OpenAI-compatible endpoint) ----
# 注意：LLM_API_KEY 要填百炼/DashScope API Key（sk-...），不是阿里云 AccessKey ID/Secret
DEMO_MODE=offline              # live / offline / replay
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-max            # 以目标账户模型目录为准（百炼控制台可查，如 qwen3.8-max）
LLM_TIMEOUT_S=120              # 读超时（秒）；推理型模型建议 >=120，过短会导致降级
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
RERANK_MODEL=

# ---- data ----
DATA_DIR=data
MOCK_DATA_DIR=data/mock

# ---- security & rate limit ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
RATE_LIMIT_DEFAULT=2000/hour
RATE_LIMIT_LOGIN=10/minute

# ---- observability ----
METRICS_ENABLED=true

# ---- demo seed passwords (change in production) ----
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EXPERT_PASSWORD=Expert@12345
SEED_KB_PASSWORD=Kb@12345
SEED_AUDIT_PASSWORD=Audit@12345
