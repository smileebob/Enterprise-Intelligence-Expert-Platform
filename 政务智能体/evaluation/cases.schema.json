{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gov-office-eval-case-v2",
  "title": "政务办公智能体评测样本",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "split",
    "task_mode",
    "data_kind",
    "input",
    "expected",
    "risk",
    "source_refs",
    "source_group",
    "label_status"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"},
    "split": {"enum": ["dev", "test"]},
    "task_mode": {
      "enum": ["policy_interpretation", "official_draft", "content_writing", "summarization", "consultation_draft", "security_routing"]
    },
    "data_kind": {"enum": ["public", "synthetic", "authorized_desensitized"]},
    "input": {
      "type": "object",
      "required": ["user_request"],
      "properties": {
        "user_request": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": ["string", "null"]},
        "as_of": {"type": ["string", "null"], "format": "date"},
        "materials": {"type": "array", "items": {"type": "string"}},
        "payload": {"type": "object", "description": "公文/文稿/安全路由的完整接口载荷；请求正文由 user_request 注入"}
      }
    },
    "expected": {
      "type": "object",
      "required": ["outcome", "criteria"],
      "properties": {
        "outcome": {"enum": ["answer", "clarify", "insufficient", "review", "block"]},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "must_include": {"type": "array", "items": {"type": "string"}},
        "must_not_include": {"type": "array", "items": {"type": "string"}},
        "required_policy_versions": {"type": "array", "items": {"type": "string"}},
        "required_citation_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "description": "草稿状态，如 pending_review / needs_revision"},
        "checks": {"type": "array", "items": {"type": "string"}, "description": "必须出现的检查项代码"},
        "http_status": {"type": "integer"},
        "error_code": {"type": "string"},
        "field_values": {"type": "object", "description": "结果中必须等于给定值的字段，点号路径"}
      }
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_group": {"type": "string", "minLength": 1, "description": "来源文件组；同一组不得跨 split"},
    "label_status": {"enum": ["draft", "reviewed", "adjudicated"]},
    "reviewer": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
